EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_CHIT_CIRCLE_ADDRESS=
EXPO_PUBLIC_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
EXPO_PUBLIC_DEPLOY_BLOCK=
# The team's relying party is chit-circle.vercel.app, already set in Vercel for
# production. Passkeys are bound to this exact hostname: a page served from any
# other origin (a Vercel preview URL, say) cannot use them, so the branch that
# deploys here has to be Vercel's production branch.
EXPO_PUBLIC_MERA_RP_ID=chit-circle.vercel.app
EXPO_PUBLIC_IOS_BUNDLE_ID=com.chitcircle.app
EXPO_PUBLIC_ANDROID_PACKAGE=com.chitcircle.app
IOS_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=

# Printed by `eas init`. Not a secret; may also be committed in app.json.
EAS_PROJECT_ID=

# Testnet-only throwaway account that funds brand-new accounts on sign-up.
# Create it with `cast wallet new` and give it 1-2 testnet MON. This value is
# inlined into the app bundle, so it must hold nothing else and must NOT be the
# deployer key. Leave blank to run without funding.
EXPO_PUBLIC_GAS_FUNDER_KEY=

# How much a brand-new account is given, and the balance below which it is
# topped up again. Whole MON. Both optional; defaults are 0.12 and 0.06.
#
# Sized from Monad's reserve rule, not from what a transaction costs. One is
# admitted only if the signer can cover the WHOLE gas limit at maxFeePerGas,
# reserved up front and refunded after — so the join that fills a circle burns
# 0.021 MON but must reserve 0.0375. The earlier 0.05/0.02 could not survive its
# own happy path: create, approve and join left 0.006 MON, and the next payment
# was refused by the node with "Signer had insufficient balance" while the
# account still held $400. See sdk/src/gas.ts.
EXPO_PUBLIC_GAS_DRIP_TOP_UP=
EXPO_PUBLIC_GAS_DRIP_MIN=