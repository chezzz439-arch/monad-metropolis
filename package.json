{
  "name": "monad-metropolis",
  "version": "1.0.0",
  "description": "Team project for the Monad Metropolis hackathon (Consumer Products & Payments track).",
  "main": "index.js",
  "scripts": {
    "start": "expo start --tunnel --dev-client",
    "start:dev": "expo start --tunnel --dev-client",
    "start:go": "expo start --tunnel --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "ios:dev": "expo run:ios --device",
    "android:dev": "expo run:android --device",
    "configure:passkeys": "node --env-file=.env scripts/generate-passkey-associations.mjs",
    "typecheck": "tsc --noEmit",
    "test:sdk": "npm --prefix sdk test",
    "test:sdk:e2e": "npm --prefix sdk run test:e2e",
    "test:contracts": "forge test --root contracts"
  },
  "dependencies": {
    "@category-labs/mera": "^0.2.0",
    "@expo/metro-runtime": "~57.0.16",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "expo": "^57.0.28",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-passkey": "^3.6.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "@foundry-rs/anvil@1.7.1": true,
    "@foundry-rs/forge@1.7.1": true
  }
}
